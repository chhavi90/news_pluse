# ---- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use a local SQLite file (zero setup).
# For a hosted Postgres (Neon / Supabase / Railway) paste the connection string:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Optional. Relative paths are resolved from the repository root.
# SQLITE_PATH=data/newspulse.db

# ---- Sources ----------------------------------------------------------------
# FEEDS_FILE=scraper/feeds.json
# MAX_ITEMS_PER_FEED=40

# ---- Extraction ---------------------------------------------------------------
# FETCH_FULL_TEXT=true
# REQUEST_TIMEOUT=12
# MAX_WORKERS=8

# ---- Clustering -----------------------------------------------------------------
# CLUSTER_METHOD=tfidf            # tfidf | keyword
# SIMILARITY_THRESHOLD=0.20       # tfidf: average cosine similarity needed to merge (0-1)
# MAX_GAP_HOURS=48                # articles further apart than this are never merged
# KEYWORD_MIN_SHARED=3            # keyword method: shared meaningful words needed
# KEYWORD_MIN_JACCARD=0.10
# STORY_SIMILARITY_THRESHOLD=0.40 # cross-outlet "same story" link
# STORY_MAX_GAP_HOURS=36
# RETAIN_DAYS=7                   # older articles are pruned on each run
# CLUSTER_MAX_ARTICLES=2000
# BODY_CHARS_FOR_VECTORS=1000     # how much of each article body feeds the TF-IDF vectors
