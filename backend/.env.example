# ---- Server -----------------------------------------------------------------
PORT=4000
# Comma separated list of allowed browser origins (wildcards allowed, e.g. https://*.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ---------------------------------------------------------------
# Empty = local SQLite file at <repo>/data/newspulse.db (zero setup).
# Hosted Postgres (Neon / Supabase / Railway) -> paste the connection string:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
# Only if your host's TLS certificate is rejected: no-verify | disable
# DATABASE_SSL=
# SQLITE_PATH=data/newspulse.db

# ---- Python pipeline (spawned by POST /ingest/trigger) ---------------------------------
# Auto-detected: <repo>/.venv first, then `python3` / `python`. Override only if needed.
# PYTHON_BIN=/usr/bin/python3
# INGEST_TIMEOUT_SECONDS=600
# INGEST_COOLDOWN_SECONDS=15
# INGEST_RATE_PER_MINUTE=6
